{
  "database": "PostgreSQL 16",
  "orm": "SQLAlchemy 2.x (async)",
  "extensions": ["pgvector", "uuid-ossp"],
  "entities": [
    {
      "name": "sources",
      "description": "技術情報の情報源（URL・論文・GitHub等）",
      "columns": [
        { "name": "id", "type": "uuid", "primary_key": true, "default": "gen_random_uuid()", "nullable": false },
        { "name": "source_type", "type": "text", "nullable": false, "comment": "paper|web_article|documentation|github_repository|blog|memo|specification" },
        { "name": "title", "type": "text", "nullable": false },
        { "name": "url", "type": "text", "nullable": true },
        { "name": "canonical_url", "type": "text", "nullable": true, "comment": "正規化済みURL（重複判定用）" },
        { "name": "author", "type": "text", "nullable": true },
        { "name": "organization", "type": "text", "nullable": true },
        { "name": "published_at", "type": "timestamptz", "nullable": true },
        { "name": "retrieved_at", "type": "timestamptz", "nullable": false },
        { "name": "source_reliability", "type": "numeric(3,2)", "nullable": true, "comment": "0.0-1.0 信頼性スコア" },
        { "name": "license", "type": "text", "nullable": true },
        { "name": "content_hash", "type": "text", "nullable": true, "comment": "コンテンツ変更検知用のハッシュ" },
        { "name": "access_status", "type": "text", "nullable": true, "comment": "ok|failed|paywalled|not_found" },
        { "name": "metadata_json", "type": "jsonb", "nullable": true, "comment": "ソース種別固有のメタデータ" },
        { "name": "tags", "type": "text[]", "nullable": true, "default": "'{}'", "comment": "ユーザー付与タグ" },
        { "name": "created_at", "type": "timestamptz", "default": "now()", "nullable": false },
        { "name": "updated_at", "type": "timestamptz", "default": "now()", "nullable": false }
      ],
      "indexes": [
        { "name": "idx_sources_canonical_url", "columns": ["canonical_url"], "unique": true, "where": "canonical_url IS NOT NULL", "reason": "URL重複判定。NULL許容のためpartial unique index" },
        { "name": "idx_sources_source_type", "columns": ["source_type"], "reason": "source_typeでのフィルタ検索" },
        { "name": "idx_sources_retrieved_at", "columns": ["retrieved_at DESC"], "reason": "最近取得したソース一覧の高速取得" }
      ]
    },
    {
      "name": "technology_items",
      "description": "技術・アルゴリズム・設計パターン・ツール等の中心エンティティ",
      "columns": [
        { "name": "id", "type": "uuid", "primary_key": true, "default": "gen_random_uuid()", "nullable": false },
        { "name": "item_type", "type": "text", "nullable": false, "comment": "technique|algorithm|architecture|architecture_pattern|design_pattern|implementation_pattern|tool|library|framework|protocol|evaluation_method|method_family" },
        { "name": "name", "type": "text", "nullable": false },
        { "name": "name_normalized", "type": "text", "nullable": false, "comment": "小文字・記号除去済みの正規化名（重複判定用）" },
        { "name": "aliases", "type": "text[]", "nullable": true, "default": "'{}'", "comment": "別名・略称の配列" },
        { "name": "summary", "type": "text", "nullable": true },
        { "name": "core_mechanism", "type": "text", "nullable": true },
        { "name": "abstract_principle", "type": "text", "nullable": true },
        { "name": "domains", "type": "text[]", "nullable": true, "default": "'{}'", "comment": "適用ドメイン（game development, AI, robotics等）" },
        { "name": "categories", "type": "text[]", "nullable": true, "default": "'{}'"},
        { "name": "problem_structures", "type": "text[]", "nullable": true, "default": "'{}'" },
        { "name": "inputs", "type": "text[]", "nullable": true, "default": "'{}'" },
        { "name": "outputs", "type": "text[]", "nullable": true, "default": "'{}'" },
        { "name": "constraints", "type": "text[]", "nullable": true, "default": "'{}'" },
        { "name": "maturity_level", "type": "text", "nullable": true, "comment": "experimental|emerging|mature|legacy" },
        { "name": "difficulty_level", "type": "text", "nullable": true, "comment": "low|medium|high" },
        { "name": "cost_level", "type": "text", "nullable": true, "comment": "low|medium|high" },
        { "name": "known_applications", "type": "text[]", "nullable": true, "default": "'{}'" },
        { "name": "evaluation_metrics", "type": "text[]", "nullable": true, "default": "'{}'" },
        { "name": "transfer_questions", "type": "text[]", "nullable": true, "default": "'{}'" },
        { "name": "embedding", "type": "vector(1536)", "nullable": true, "comment": "text-embedding-3-smallによるベクトル（summary + core_mechanism + abstract_principle を結合してembedding）" },
        { "name": "tsv", "type": "tsvector", "nullable": true, "comment": "全文検索用（name + summary + abstract_principle）。GEN ALWAYS AS STORED で自動更新" },
        { "name": "last_seen_at", "type": "timestamptz", "nullable": true, "comment": "最後に情報源で確認された日時" },
        { "name": "created_at", "type": "timestamptz", "default": "now()", "nullable": false },
        { "name": "updated_at", "type": "timestamptz", "default": "now()", "nullable": false }
      ],
      "indexes": [
        { "name": "idx_tech_name_normalized", "columns": ["name_normalized"], "unique": true, "reason": "技術名重複防止。正規化名で一意性保証" },
        { "name": "idx_tech_embedding", "type": "ivfflat", "columns": ["embedding vector_cosine_ops"], "with": "lists=100", "reason": "pgvectorによるコサイン類似度検索の高速化" },
        { "name": "idx_tech_tsv", "type": "gin", "columns": ["tsv"], "reason": "PostgreSQL全文検索の高速化" },
        { "name": "idx_tech_domains", "type": "gin", "columns": ["domains"], "reason": "ドメインフィルタ検索" },
        { "name": "idx_tech_item_type", "columns": ["item_type"], "reason": "item_typeでのフィルタ検索" },
        { "name": "idx_tech_maturity", "columns": ["maturity_level"], "reason": "成熟度フィルタ検索" }
      ],
      "design_note": "name_normalizedはLower(name)から記号を除去したもの。aliasesはGIN indexで検索可能にする将来拡張を想定"
    },
    {
      "name": "technology_purposes",
      "description": "技術の目的（何のために使うか）を条件付きで保存",
      "columns": [
        { "name": "id", "type": "uuid", "primary_key": true, "default": "gen_random_uuid()", "nullable": false },
        { "name": "technology_id", "type": "uuid", "nullable": false, "foreign_key": "technology_items(id)", "on_delete": "CASCADE" },
        { "name": "purpose", "type": "text", "nullable": false },
        { "name": "condition", "type": "text", "nullable": true },
        { "name": "abstraction_level", "type": "text", "nullable": true, "comment": "concrete|abstract|principle" },
        { "name": "created_at", "type": "timestamptz", "default": "now()", "nullable": false }
      ],
      "indexes": [
        { "name": "idx_purposes_technology_id", "columns": ["technology_id"], "reason": "技術IDによる高速絞り込み" }
      ]
    },
    {
      "name": "technology_benefits",
      "description": "技術のメリットを条件付きで保存",
      "columns": [
        { "name": "id", "type": "uuid", "primary_key": true, "default": "gen_random_uuid()", "nullable": false },
        { "name": "technology_id", "type": "uuid", "nullable": false, "foreign_key": "technology_items(id)", "on_delete": "CASCADE" },
        { "name": "benefit", "type": "text", "nullable": false },
        { "name": "condition", "type": "text", "nullable": true },
        { "name": "evidence_source_id", "type": "uuid", "nullable": true, "foreign_key": "sources(id)", "on_delete": "SET NULL" },
        { "name": "confidence_score", "type": "numeric(3,2)", "nullable": true },
        { "name": "created_at", "type": "timestamptz", "default": "now()", "nullable": false }
      ],
      "indexes": [
        { "name": "idx_benefits_technology_id", "columns": ["technology_id"], "reason": "技術IDによる高速絞り込み" }
      ]
    },
    {
      "name": "technology_drawbacks",
      "description": "技術のデメリットを条件付きで保存",
      "columns": [
        { "name": "id", "type": "uuid", "primary_key": true, "default": "gen_random_uuid()", "nullable": false },
        { "name": "technology_id", "type": "uuid", "nullable": false, "foreign_key": "technology_items(id)", "on_delete": "CASCADE" },
        { "name": "drawback", "type": "text", "nullable": false },
        { "name": "condition", "type": "text", "nullable": true },
        { "name": "severity", "type": "text", "nullable": true, "comment": "low|medium|high" },
        { "name": "evidence_type", "type": "text", "nullable": true, "comment": "observed|inferred|unknown" },
        { "name": "evidence_source_id", "type": "uuid", "nullable": true, "foreign_key": "sources(id)", "on_delete": "SET NULL" },
        { "name": "confidence_score", "type": "numeric(3,2)", "nullable": true },
        { "name": "created_at", "type": "timestamptz", "default": "now()", "nullable": false }
      ],
      "indexes": [
        { "name": "idx_drawbacks_technology_id", "columns": ["technology_id"], "reason": "技術IDによる高速絞り込み" }
      ]
    },
    {
      "name": "technology_tradeoffs",
      "description": "技術のトレードオフ（得るものと失うもの）を保存",
      "columns": [
        { "name": "id", "type": "uuid", "primary_key": true, "default": "gen_random_uuid()", "nullable": false },
        { "name": "technology_id", "type": "uuid", "nullable": false, "foreign_key": "technology_items(id)", "on_delete": "CASCADE" },
        { "name": "gain", "type": "text", "nullable": false },
        { "name": "cost", "type": "text", "nullable": false },
        { "name": "condition", "type": "text", "nullable": true },
        { "name": "created_at", "type": "timestamptz", "default": "now()", "nullable": false }
      ],
      "indexes": [
        { "name": "idx_tradeoffs_technology_id", "columns": ["technology_id"], "reason": "技術IDによる高速絞り込み" }
      ]
    },
    {
      "name": "technology_conditions",
      "description": "技術が有効な条件・避けるべき条件（works_when / fails_when / avoid_when）を保存",
      "columns": [
        { "name": "id", "type": "uuid", "primary_key": true, "default": "gen_random_uuid()", "nullable": false },
        { "name": "technology_id", "type": "uuid", "nullable": false, "foreign_key": "technology_items(id)", "on_delete": "CASCADE" },
        { "name": "condition_type", "type": "text", "nullable": false, "comment": "works_when|fails_when|avoid_when|requires" },
        { "name": "description", "type": "text", "nullable": false },
        { "name": "evidence_source_id", "type": "uuid", "nullable": true, "foreign_key": "sources(id)", "on_delete": "SET NULL" },
        { "name": "confidence_score", "type": "numeric(3,2)", "nullable": true },
        { "name": "created_at", "type": "timestamptz", "default": "now()", "nullable": false }
      ],
      "indexes": [
        { "name": "idx_conditions_technology_id", "columns": ["technology_id"], "reason": "技術IDによる高速絞り込み" },
        { "name": "idx_conditions_type", "columns": ["condition_type"], "reason": "条件種別でのフィルタ" }
      ]
    },
    {
      "name": "technology_relations",
      "description": "技術同士の関係（alternative_to, combines_with, depends_on等）を保存",
      "columns": [
        { "name": "id", "type": "uuid", "primary_key": true, "default": "gen_random_uuid()", "nullable": false },
        { "name": "subject_technology_id", "type": "uuid", "nullable": false, "foreign_key": "technology_items(id)", "on_delete": "CASCADE" },
        { "name": "relation_type", "type": "text", "nullable": false, "comment": "similar_to|alternative_to|combines_with|depends_on|implements|used_in|transfers_to|solves_same_problem_as|more_general_than|more_specific_than|improves|replaces" },
        { "name": "object_technology_id", "type": "uuid", "nullable": false, "foreign_key": "technology_items(id)", "on_delete": "CASCADE" },
        { "name": "strength", "type": "numeric(3,2)", "nullable": true, "comment": "関係の強度 0.0-1.0" },
        { "name": "reason", "type": "text", "nullable": true },
        { "name": "evidence_source_id", "type": "uuid", "nullable": true, "foreign_key": "sources(id)", "on_delete": "SET NULL" },
        { "name": "created_at", "type": "timestamptz", "default": "now()", "nullable": false }
      ],
      "indexes": [
        { "name": "idx_relations_subject", "columns": ["subject_technology_id"], "reason": "主体技術からの関係検索" },
        { "name": "idx_relations_object", "columns": ["object_technology_id"], "reason": "客体技術からの逆引き検索" },
        { "name": "idx_relations_type", "columns": ["relation_type"], "reason": "関係種別でのフィルタ" },
        { "name": "idx_relations_pair_unique", "columns": ["subject_technology_id", "relation_type", "object_technology_id"], "unique": true, "reason": "同一ペア・同一関係種別の重複登録防止" }
      ]
    },
    {
      "name": "use_cases",
      "description": "技術が使われる課題や応用例",
      "columns": [
        { "name": "id", "type": "uuid", "primary_key": true, "default": "gen_random_uuid()", "nullable": false },
        { "name": "title", "type": "text", "nullable": false },
        { "name": "domain", "type": "text", "nullable": true },
        { "name": "problem_description", "type": "text", "nullable": true },
        { "name": "requirements", "type": "text[]", "nullable": true, "default": "'{}'" },
        { "name": "constraints", "type": "text[]", "nullable": true, "default": "'{}'" },
        { "name": "evaluation_metrics", "type": "text[]", "nullable": true, "default": "'{}'" },
        { "name": "embedding", "type": "vector(1536)", "nullable": true },
        { "name": "created_at", "type": "timestamptz", "default": "now()", "nullable": false },
        { "name": "updated_at", "type": "timestamptz", "default": "now()", "nullable": false }
      ],
      "indexes": [
        { "name": "idx_use_cases_embedding", "type": "ivfflat", "columns": ["embedding vector_cosine_ops"], "with": "lists=100", "reason": "ユースケースのベクトル検索高速化" },
        { "name": "idx_use_cases_domain", "columns": ["domain"], "reason": "ドメインフィルタ検索" }
      ]
    },
    {
      "name": "use_case_technologies",
      "description": "ユースケースと技術のマッピング",
      "columns": [
        { "name": "id", "type": "uuid", "primary_key": true, "default": "gen_random_uuid()", "nullable": false },
        { "name": "use_case_id", "type": "uuid", "nullable": false, "foreign_key": "use_cases(id)", "on_delete": "CASCADE" },
        { "name": "technology_id", "type": "uuid", "nullable": false, "foreign_key": "technology_items(id)", "on_delete": "CASCADE" },
        { "name": "fit_score", "type": "numeric(4,3)", "nullable": true, "comment": "0.000-1.000 適合度スコア" },
        { "name": "reason", "type": "text", "nullable": true },
        { "name": "implementation_note", "type": "text", "nullable": true },
        { "name": "evidence_source_id", "type": "uuid", "nullable": true, "foreign_key": "sources(id)", "on_delete": "SET NULL" },
        { "name": "created_at", "type": "timestamptz", "default": "now()", "nullable": false }
      ],
      "indexes": [
        { "name": "idx_uc_tech_use_case", "columns": ["use_case_id"], "reason": "ユースケースIDからの技術引き当て" },
        { "name": "idx_uc_tech_technology", "columns": ["technology_id"], "reason": "技術IDからの利用例引き当て" },
        { "name": "idx_uc_tech_pair_unique", "columns": ["use_case_id", "technology_id"], "unique": true, "reason": "同一ペアの重複登録防止" }
      ]
    },
    {
      "name": "evidence",
      "description": "技術情報の根拠（ソースからの短い引用・言い換え）",
      "columns": [
        { "name": "id", "type": "uuid", "primary_key": true, "default": "gen_random_uuid()", "nullable": false },
        { "name": "source_id", "type": "uuid", "nullable": false, "foreign_key": "sources(id)", "on_delete": "CASCADE" },
        { "name": "technology_id", "type": "uuid", "nullable": true, "foreign_key": "technology_items(id)", "on_delete": "CASCADE" },
        { "name": "evidence_type", "type": "text", "nullable": true, "comment": "observed|inferred|unknown" },
        { "name": "short_quote", "type": "text", "nullable": true, "comment": "必要最小限の短い引用（著作権配慮）" },
        { "name": "paraphrase", "type": "text", "nullable": true, "comment": "AI言い換えテキスト" },
        { "name": "locator", "type": "text", "nullable": true, "comment": "page, section, paragraph等の位置情報" },
        { "name": "confidence_score", "type": "numeric(3,2)", "nullable": true },
        { "name": "created_at", "type": "timestamptz", "default": "now()", "nullable": false }
      ],
      "indexes": [
        { "name": "idx_evidence_source", "columns": ["source_id"], "reason": "ソースIDからの根拠検索" },
        { "name": "idx_evidence_technology", "columns": ["technology_id"], "reason": "技術IDからの根拠検索" }
      ]
    }
  ],
  "relations": [
    {
      "from_table": "technology_purposes",
      "from_column": "technology_id",
      "to_table": "technology_items",
      "to_column": "id",
      "type": "many_to_one",
      "on_delete": "CASCADE"
    },
    {
      "from_table": "technology_benefits",
      "from_column": "technology_id",
      "to_table": "technology_items",
      "to_column": "id",
      "type": "many_to_one",
      "on_delete": "CASCADE"
    },
    {
      "from_table": "technology_drawbacks",
      "from_column": "technology_id",
      "to_table": "technology_items",
      "to_column": "id",
      "type": "many_to_one",
      "on_delete": "CASCADE"
    },
    {
      "from_table": "technology_tradeoffs",
      "from_column": "technology_id",
      "to_table": "technology_items",
      "to_column": "id",
      "type": "many_to_one",
      "on_delete": "CASCADE"
    },
    {
      "from_table": "technology_conditions",
      "from_column": "technology_id",
      "to_table": "technology_items",
      "to_column": "id",
      "type": "many_to_one",
      "on_delete": "CASCADE"
    },
    {
      "from_table": "technology_relations",
      "from_column": "subject_technology_id",
      "to_table": "technology_items",
      "to_column": "id",
      "type": "many_to_one",
      "on_delete": "CASCADE"
    },
    {
      "from_table": "technology_relations",
      "from_column": "object_technology_id",
      "to_table": "technology_items",
      "to_column": "id",
      "type": "many_to_one",
      "on_delete": "CASCADE"
    },
    {
      "from_table": "use_case_technologies",
      "from_column": "use_case_id",
      "to_table": "use_cases",
      "to_column": "id",
      "type": "many_to_one",
      "on_delete": "CASCADE"
    },
    {
      "from_table": "use_case_technologies",
      "from_column": "technology_id",
      "to_table": "technology_items",
      "to_column": "id",
      "type": "many_to_one",
      "on_delete": "CASCADE"
    },
    {
      "from_table": "evidence",
      "from_column": "source_id",
      "to_table": "sources",
      "to_column": "id",
      "type": "many_to_one",
      "on_delete": "CASCADE"
    },
    {
      "from_table": "evidence",
      "from_column": "technology_id",
      "to_table": "technology_items",
      "to_column": "id",
      "type": "many_to_one",
      "on_delete": "CASCADE"
    }
  ],
  "er_diagram_ascii": "
sources ||--o{ evidence : \"provides evidence for\"
sources ||--o{ technology_benefits : \"evidences\"
sources ||--o{ technology_drawbacks : \"evidences\"
sources ||--o{ technology_conditions : \"evidences\"
sources ||--o{ technology_relations : \"evidences\"
sources ||--o{ use_case_technologies : \"evidences\"

technology_items ||--o{ technology_purposes : \"has\"
technology_items ||--o{ technology_benefits : \"has\"
technology_items ||--o{ technology_drawbacks : \"has\"
technology_items ||--o{ technology_tradeoffs : \"has\"
technology_items ||--o{ technology_conditions : \"has\"
technology_items ||--o{ technology_relations : \"subject of\"
technology_items ||--o{ technology_relations : \"object of\"
technology_items ||--o{ evidence : \"evidenced by\"
technology_items ||--o{ use_case_technologies : \"used in\"

use_cases ||--o{ use_case_technologies : \"uses\"
  ",
  "migration_strategy": {
    "tool": "Alembic",
    "approach": "alembic revision --autogenerate で差分マイグレーションを生成し、alembic upgrade head で適用",
    "rollback": "alembic downgrade -1 で1ステップロールバック",
    "initial_setup": "CREATE EXTENSION IF NOT NULL vector; CREATE EXTENSION IF NOT NULL 'uuid-ossp'; を最初のマイグレーションに含める"
  },
  "design_decisions": [
    {
      "decision": "technology_items に tsv（tsvector）カラムを追加してPostgreSQL全文検索に対応",
      "reason": "name + summary + abstract_principleを結合したtsvectorを事前計算することで、GINインデックスを活用した高速全文検索が可能。GENERATED ALWAYS AS STORED でupdated_atと連動して自動更新。"
    },
    {
      "decision": "embeddingカラムはvector(1536)でtext-embedding-3-smallと合わせた",
      "reason": "tech_stack.yamlでtext-embedding-3-small (1536次元) を採用しているため。将来的にvoyage-3-lite (1024次元) に変更する場合はmigrationが必要。"
    },
    {
      "decision": "メリット・デメリット・条件等を別テーブルに正規化（非JSONB配列）",
      "reason": "条件付きのメリット・デメリット・トレードオフをGROUP BYや集計でクエリするため。JSONBでは集計が困難。技術カード詳細表示時はJOINで一括取得する。"
    },
    {
      "decision": "use_casesテーブルにもembeddingを持たせた",
